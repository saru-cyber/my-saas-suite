# ドメイン設定（本番では .your-suite.com）
NEXT_PUBLIC_HUB_URL="http://localhost:3000"
COOKIE_DOMAIN="localhost"

# 外部サービス（手動設定・ダミー値）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_hub?schema=public"
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_STRIPE_PUBLISHABLE_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET"

# 内部接続用（CLIがリアルな乱数を自動生成）
HUB_JWT_SECRET=""
APP1_INTERNAL_API_KEY=""

# Google OAuth。未設定のときはログイン画面の開発用モックを使う
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# カンマ区切り。ここに含まれるメールだけが管理者になる
ADMIN_EMAILS="admin@example.com"
